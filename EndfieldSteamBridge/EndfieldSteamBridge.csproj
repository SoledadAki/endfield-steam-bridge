<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{C00CA607-FFCF-4496-9BEA-5F2414E1AE20}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>EndfieldSteamBridge</RootNamespace>
    <AssemblyName>EndfieldSteamBridge</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Optimize>true</Optimize>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\EndfieldSteamBridge.ico</ApplicationIcon>
    <CodePage>65001</CodePage><GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DefineConstants></DefineConstants>
    <BridgeFrontendPath>obj\$(Configuration)\EndfieldBridge.exe</BridgeFrontendPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.Web.Extensions" /><Reference Include="System.Management" />
    <Compile Include="src\*.cs" />
    <EmbeddedResource Include="assets\background.png"><LogicalName>EndfieldSteamBridge.Background</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="LICENSE"><LogicalName>EndfieldSteamBridge.License</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="$(BridgeFrontendPath)"><LogicalName>EndfieldSteamBridge.Frontend</LogicalName></EmbeddedResource>
    <None Include="assets\EndfieldSteamBridge.ico" />
    <None Include="app.manifest" /><None Include="bridge.manifest" /><None Include="README.md" /><None Include="请以管理员身份运行程序.txt" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="BuildBridgeFrontend" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <MakeDir Directories="obj\$(Configuration)" />
    <ItemGroup>
      <FrontendResource Include="assets\background.png"><LogicalName>EndfieldSteamBridge.Background</LogicalName></FrontendResource>
      <FrontendResource Include="LICENSE"><LogicalName>EndfieldSteamBridge.License</LogicalName></FrontendResource>
    </ItemGroup>
    <Csc NoConfig="true" Sources="@(Compile)" References="@(ReferencePath)" Resources="@(FrontendResource)" OutputAssembly="$(BridgeFrontendPath)" TargetType="winexe" Platform="x64" Optimize="true" CodePage="65001" DefineConstants="BRIDGE_FRONTEND;$(DefineConstants)" Win32Manifest="bridge.manifest" Win32Icon="assets\EndfieldSteamBridge.ico" />
  </Target>
</Project>
